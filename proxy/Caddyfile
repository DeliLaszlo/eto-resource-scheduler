# A kit saját HTTPS proxyja: a cím és a megbízható proxyk a .env fájlból jönnek
{
	servers {
		protocols h1 h2
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
	}
}

{$FRONTEND_URL} {
	request_body {
		max_size 10MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}
